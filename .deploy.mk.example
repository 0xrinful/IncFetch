# Copy this file to .deploy.mk and fill in your VPS details.
# .deploy.mk is gitignored and automatically loaded by Makefile.

VPS_HOST    = ubuntu@your-vps-ip
VPS_PORT    = 22
VPS_DIR     = /opt/inkfetch
VPS_SERVICE = inkfetch
